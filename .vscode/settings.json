{
  // Python: use the backend's virtual environment so imports (langgraph, fastapi, ...) resolve.
  // Type checking follows pyrightconfig.json at the repo root.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],

  // CSS: Tailwind v4 at-rules (@theme, @custom-variant) are valid; treat .css as Tailwind CSS.
  "files.associations": { "*.css": "tailwindcss" },
  "css.lint.unknownAtRules": "ignore",

  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true }
}
