# Groq LLM. Leave as-is to run in offline MOCK MODE (rule-based parser).
GROQ_API_KEY=your_groq_api_key_here
# Any JSON-mode chat model your Groq key can use (list: GET https://api.groq.com/openai/v1/models).
# llama-3.3-70b-versatile was the original choice; use it if your account still has it.
GROQ_MODEL=openai/gpt-oss-120b
# Speech-to-text model for voice input (Groq Whisper). whisper-large-v3 is slower but slightly more accurate.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aivoa_qms

# Default manufacturing site stamped on new deviations (Tier C, system value)
DEFAULT_SITE=Unit-II, Hyderabad API Plant

# Full path to tesseract.exe on Windows (leave blank if tesseract is on PATH)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional: folder containing poppler's pdftoppm (only needed for scanned-PDF OCR)
POPPLER_PATH=
